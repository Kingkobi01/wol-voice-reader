# WOL Voice Reader — environment variables
#
# Copy this file to .env.local and fill in values as needed.
# This file is safe to commit; .env.local is NOT.

# ── Voicebox (local desktop app — voicebox.sh) ──────────────────────────────
#
# The local Voicebox application runs its REST API on port 17493 by default.
# Change this only if you have configured Voicebox to use a different port.
#
VOICEBOX_HOST=http://127.0.0.1:17493
#
# No API key is required — Voicebox is a local application.
# No external cloud TTS service is used.
